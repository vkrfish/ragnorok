# Application Settings
PROJECT_NAME="Notebook RAG"
DEBUG=True
API_V1_STR="/v1"

# Database Configuration (Supabase Postgres or local Postgres fallback)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/postgres"

# Supabase Configuration
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_KEY="your-supabase-service-role-or-anon-key"
SUPABASE_STORAGE_BUCKET="raw-sources"

# Storage Settings
STORAGE_BACKEND="local" # "local" or "supabase"
LOCAL_STORAGE_DIR="./media"

# Redis Configuration (for async workers in Phase 2)
REDIS_URL="redis://localhost:6379/0"

# Qdrant Vector Store Configuration (Phase 2)
QDRANT_URL="http://localhost:6333"
